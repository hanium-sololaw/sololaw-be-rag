APP_NAME=
ENV=
OPENAI_API_KEY=
# 국가법령정보센터 Open API 인증키 (open.law.go.kr 발급)
LAW_API_KEY=
# 판례 임베딩 저장소 (RAG 전용 pgvector)
# 배포: postgresql://rag:<비밀번호>@vector-db:5432/rag
VECTOR_DB_URL=
VECTOR_DB_PASSWORD=
# nginx 프록시 경로 prefix. 로컬은 비워두고, 배포 서버에서만 /rag
ROOT_PATH=
CORS_ORIGINS=["https://www.sololaw.site","https://sololaw.site","http://localhost:5173"]
